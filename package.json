{
  "name": "strategos",
  "version": "1.2.0",
  "description": "Control multiple Claude Code instances from your iPad",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "start": "cd server && npm start",
    "server": "cd server && npm start",
    "build": "cd client && npm run build",
    "test": "npx playwright test",
    "test:server": "find server -name '*.test.js' -not -path '*/node_modules/*' -type f | xargs node --test --experimental-test-module-mocks",
    "test:ui": "npx playwright test --ui",
    "test:headed": "npx playwright test --headed",
    "lint": "node_modules/.bin/eslint server/ client/src/",
    "lint:fix": "node_modules/.bin/eslint server/ client/src/ --fix"
  },
  "bin": {
    "thea-cc": "./bin/thea-cc.js"
  },
  "keywords": [
    "claude-code",
    "orchestrator",
    "tmux",
    "ai"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "concurrently": "^8.2.2",
    "eslint": "^10.2.1",
    "globals": "^17.5.0"
  },
  "dependencies": {
    "micromatch": "^4.0.8"
  }
}
